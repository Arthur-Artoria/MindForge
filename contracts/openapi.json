      "get": {
        "tags": ["mind-forge-application"],
        "operationId": "hello",
        "parameters": [
          { "name": "name", "in": "query", "required": false, "schema": { "type": "string", "default": "World" } }
        ],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "string" } } } } }
      }
