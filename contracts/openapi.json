  "components": {
    "schemas": {
      "UpdateNoteRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 255, "minLength": 0 },
          "content": { "type": "string" }
        },
        "required": ["content", "title"]
      },
      "NoteResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ApiErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_CREDENTIALS",
              "AUTHENTICATION_REQUIRED",
              "ACCESS_DENIED",
              "CSRF_TOKEN_INVALID",
              "RESOURCE_NOT_FOUND"
            ]
          },
          "message": { "type": "string" }
        }
      },
      "CreateNoteRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 255, "minLength": 0 },
          "content": { "type": "string" }
        },
        "required": ["content", "title"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "minLength": 1 },
          "password": { "type": "string", "minLength": 1 }
        },
        "required": ["email", "password"]
      },
      "CurrentUserResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "email": { "type": "string" },
          "username": { "type": "string" }
        }
      },
      "CsrfTokenResponse": {
        "type": "object",
        "properties": { "headerName": { "type": "string" }, "token": { "type": "string" } }
      }
    },
    "parameters": {
      "csrfHeader": {
        "name": "X-CSRF-TOKEN",
        "in": "header",
        "description": "与当前 Session 绑定的 CSRF token",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "securitySchemes": { "sessionCookie": { "type": "apiKey", "name": "JSESSIONID", "in": "cookie" } }
  }
}
